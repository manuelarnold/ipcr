Package: ipcr
Type: Package
Title: Individual Parameter Contribution Regression
Version: 0.3.0
Authors@R: c(person("Manuel", "Arnold", email = "manuel.arnold@hu-berlin.de",
                    role = c("aut", "cre")),
             person("Julien Patrick", "Irmer",
                    email = "julien.irmer@hu-berlin.de", role = c("aut")))
Description: Provides methods for explaining and predicting individual and group
    differences in model parameters using individual parameter contribution
    regression (IPCR). The package is primarily designed for structural equation
    models fitted with the lavaan and OpenMx packages, but also supports lme4,
    as well asthe lm and glm functions from the stats package.
License: GPL-3
Encoding: UTF-8
LazyData: true
Imports: ggplot2, glmnet, lavaan, lme4, lmtest, merDeriv, methods, OpenMx, sandwich
Roxygen: list(markdown = TRUE)
RoxygenNote: 7.3.2
